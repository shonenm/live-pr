Output assets/local-first.gif

Set Shell "bash"
Set FontSize 16
Set Width 1200
Set Height 720
Set Padding 12
Set TypingSpeed 35ms

Type "go run . demo"
Enter
Sleep 8s

# Open the commit picker: Published, Local only, Remote only, Working tree.
Type "c"
Sleep 5s
Type "j"
Sleep 2s
Type "j"
Sleep 2s
Type "j"
Sleep 4s

Type "q"
Sleep 2s
