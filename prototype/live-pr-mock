#!/usr/bin/env bash
# live-pr-mock — throwaway TUI mock to validate the "living PR" experience.
# Styled after GitHub's PR page / gh-dash (Primer palette, status pills, a
# two-pane conversation view). The pinned PR header (Open badge, base<-head,
# labels) sits on top; the decision/pivot/commit timeline is the list; each
# event renders as a GitHub-style comment card in the preview. Enter launches
# the pluggable reviewer scoped to the commit.
#
#   Reviewer template (env LIVE_PR_REVIEWER), {sha} substituted:
#     default: nvim -c "CodeDiff {sha}~1 {sha}"      (your codediff review mode)
#     try:     git show {sha} | delta | less -R  |  difit {sha}
#
# Run:  ./live-pr-mock
#       tmux popup -E -w 92% -h 92% -- "$PWD/live-pr-mock"

set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
self="$here/live-pr-mock"
tl="$here/timeline.jsonl"
concl="$here/conclusion.md"
reviewer_tmpl="${LIVE_PR_REVIEWER:-nvim -c \"CodeDiff {sha}~1 {sha}\"}"
cd "$(git -C "$here" rev-parse --show-toplevel 2>/dev/null || echo "$here")"

# --- Primer palette (R;G;B) ---------------------------------------------------
FG='230;237;243'; MUTED='139;148;158'; SUBTLE='33;38;45'; BORDER='48;54;61'
GREEN='35;134;54'; GREENFG='63;185;80'; REDFG='248;81;73'
BLUE='31;111;235'; YELLOW='158;113;16'; MAG='137;87;229'; GREY='72;79;88'

fg()  { printf '\033[38;2;%sm' "$1"; }                 # set fg
bgtxt(){ printf '\033[38;2;%s;48;2;%sm%s\033[0m' "$1" "$2" "$3"; }  # fg,bg,text
rst=$'\033[0m'; b=$'\033[1m'

kind_meta() { # -> K_LABEL K_BG K_ICON
  case "$1" in
    decision) K_LABEL=DECISION; K_BG=$YELLOW; K_ICON='◆' ;;
    pivot)    K_LABEL=PIVOT;    K_BG=$MAG;    K_ICON='⟲' ;;
    commit)   K_LABEL=COMMIT;   K_BG=$GREEN;  K_ICON='◉' ;;
    summary)  K_LABEL=SUMMARY;  K_BG=$BLUE;   K_ICON='▸' ;;
    *)        K_LABEL=NOTE;     K_BG=$GREY;   K_ICON='·' ;;
  esac
}

rec()   { sed -n "${1}p" "$tl"; }
field() { jq -r "$2" <<<"$(rec "$1")"; }

# --- preview: a GitHub-style comment card -------------------------------------
if [[ "${1:-}" == --preview ]]; then
  n="$2"; cols="${FZF_PREVIEW_COLUMNS:-72}"
  kind=$(field "$n" .kind); ts=$(field "$n" .ts)
  title=$(field "$n" .title); body=$(field "$n" .body)
  kind_meta "$kind"
  who='claude-agent'; ava='🤖'
  [[ "$kind" == note ]] && { who='shonenm'; ava='👤'; }
  # comment-card header bar (subtle background full width)
  bar=$(printf ' %s %s  %scommented  · %s' "$ava" "$who" "$(fg "$MUTED")" "${ts/T/ }")
  pad=$(( cols - ${#who} - ${#ts} - 20 )); ((pad<1)) && pad=1
  printf '%s%s%*s%s\n' "$(printf '\033[48;2;%sm' "$SUBTLE")" "$bar" "$pad" '' "$rst"
  printf '%b %-9s%b  %b%s%b\n\n' "$(bgtxt '13;17;23' "$K_BG" " $K_LABEL ")" '' "" "$b$(fg "$FG")" "$title" "$rst"
  printf '%b%s%b\n' "$(fg "$FG")" "$body" "$rst"
  if [[ "$kind" == commit ]]; then
    sha=$(field "$n" .sha)
    printf '\n%s%s%b\n' "$(fg "$BORDER")" "$(printf '─%.0s' $(seq 1 "$cols"))" "$rst"
    printf '%b  %s%b  %s\n' "$(bgtxt '13;17;23' "$GREEN" " ◉ ")" "$(fg "$MUTED")$sha" "$rst" "$(field "$n" .title)"
    git show --stat --color=always --format='%C(dim)%an committed · %ad%C(reset)%n' --date=short "$sha" 2>/dev/null | sed -n '1,30p'
    printf '\n%b↵ Enter — この commit を reviewer で開く%b\n' "$(fg "$MUTED")" "$rst"
  fi
  exit 0
fi

# --- review action ------------------------------------------------------------
if [[ "${1:-}" == --review ]]; then
  n="$2"; kind=$(field "$n" .kind)
  if [[ "$kind" == commit ]]; then
    sha=$(field "$n" .sha); cmd="${reviewer_tmpl//\{sha\}/$sha}"; eval "$cmd"
  else
    { field "$n" .title; echo; field "$n" .body; } | fold -s -w 100 | less -R
  fi
  exit 0
fi

# --- PR header (pinned) -------------------------------------------------------
title="$(head -1 "$concl")"
label() { bgtxt "$FG" "$GREY" " $1 "; }
h1=$(printf '%b  %b%s%b  %b#309%b' \
      "$(bgtxt '255;255;255' "$GREEN" ' ⇄ Open ')" "$b$(fg "$FG")" "$title" "$rst" "$(fg "$MUTED")" "$rst")
h2=$(printf '%b⎇%b %bmain%b %b←%b %bcodediff-review-mode%b   %b·%b 2 commits   %b+247%b %b−4%b   %s %s %s' \
      "$(fg "$MUTED")" "$rst" "$b$(fg "$FG")" "$rst" "$(fg "$MUTED")" "$rst" "$(fg "$FG")" "$rst" \
      "$(fg "$MUTED")" "$rst" "$(fg "$GREENFG")" "$rst" "$(fg "$REDFG")" "$rst" \
      "$(label enhancement)" "$(label nvim)" "$(label zsh)")
tabs=$(printf '%b● Conversation%b   %bCommits 2   Files changed 3   Checks%b' "$(fg "$FG")$b" "$rst" "$(fg "$MUTED")" "$rst")
header=$(printf '%b\n%b\n%b' "$h1" "$h2" "$tabs")

# --- timeline list (field1 = index hidden; field2.. shown) --------------------
list=""; i=0
while IFS= read -r json; do
  i=$((i+1))
  kind=$(jq -r '.kind' <<<"$json")
  ts=$(jq -r '.ts' <<<"$json" | sed 's/T/ /; s/^2026-//')
  ttl=$(jq -r '.title' <<<"$json")
  kind_meta "$kind"
  pill=$(bgtxt '13;17;23' "$K_BG" " $(printf '%-8s' "$K_LABEL") ")
  sha=''; [[ "$kind" == commit ]] && sha=" $(fg "$GREENFG")$(jq -r '.sha' <<<"$json")$rst"
  row=$(printf '%b  %b%s%b  %b%s%b' "$pill" "$(fg "$MUTED")" "$ts" "$rst" "$(fg "$FG")" "$ttl" "$rst")
  list+="$i"$'\t'"$row$sha"$'\n'
done < "$tl"

printf '%b' "$list" | fzf \
  --ansi --no-sort --layout=reverse --cycle \
  --header "$(printf '%b' "$header")" --header-first \
  --delimiter='\t' --with-nth=2.. \
  --prompt '  ▸ ' --pointer '▌' --marker '✓' \
  --preview "$self --preview {1}" \
  --preview-window 'right:54%:wrap:border-left' \
  --bind "enter:execute($self --review {1})" \
  --border rounded --border-label ' living pr #309 ' --border-label-pos 2 \
  --color 'fg:250,fg+:255,bg+:-1,hl:2,hl+:2,border:8,label:2,header:-1,pointer:2,prompt:2,preview-border:8'
